# rustcorder environment configuration
#
# PUNCH_BACK_TIME — how many seconds to rewind before playing back during a
# punch-and-roll operation. The playback starts this many seconds before the
# end of the last recording. Minimum: 1.0, no maximum enforced.
PUNCH_BACK_TIME=5s

#CROSSFADE_TIME=10ms
CROSSFADE_TIME=50ms

DISCARD_SHORT_CLIPS=true
DISCARD_DURATION=1s

# EPUB reader
#
# EPUB_SCROLL_LINES — number of wrapped lines to scroll per ← / → keypress.
EPUB_SCROLL_LINES=3
#
# EPUB_AUTOSCROLL — auto-scroll speed in lines per minute while recording.
# Set to 0 (or leave commented) to disable auto-scroll entirely.
EPUB_AUTOSCROLL=0
#
# EPUB_PANE_RATIO — percentage of the body area given to the EPUB text pane.
# The recording metrics pane takes the remaining percentage above it.
EPUB_PANE_RATIO=60

# WEB_MODE — when true, the TUI is disabled entirely and all interaction
# happens through the browser UI at http://localhost:7474/.
# Logs print directly to the terminal instead of being hidden by the TUI.
WEB_MODE=true

# EPUB_PANE — controls where the EPUB text is displayed.
#   terminal  (default) show in terminal split-pane
#   browser             suppress terminal pane; browser window is the reader
#   both                show in both (useful for debugging)
EPUB_PANE=browser

# BROWSER_OPEN — when true, auto-open http://localhost:<port>/ at startup
# using xdg-open (Linux) / open (macOS).
BROWSER_OPEN=true

DEFAULT_RECORDING_DIR=./recordings